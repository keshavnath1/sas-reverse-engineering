{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sas-re:local-authorization:1.0",
  "title": "CP2 local authorization declarations (not filesystem authorization)",
  "$comment": "Structural contract only. Pure semantic/path validation is also required. No path grants access, no binding belongs in portable evidence, no approval is authenticated.",
  "type": "object",
  "properties": {
    "authorization_schema_version": {
      "const": "1.0"
    },
    "identity_projection": {
      "const": "sas-re-scope-v1"
    },
    "platform": {
      "$ref": "#/$defs/Platform"
    },
    "logical_scope": {
      "$ref": "#/$defs/LogicalScope"
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Binding"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "authorization": {
      "$ref": "#/$defs/AuthorizationDeclaration"
    }
  },
  "required": [
    "authorization_schema_version",
    "identity_projection",
    "platform",
    "logical_scope",
    "bindings",
    "authorization"
  ],
  "additionalProperties": false,
  "$defs": {
    "SafeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
    },
    "FileKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[^\\r\\n]+(?![\\s\\S])"
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1
    },
    "FileKind": {
      "type": "string",
      "enum": [
        "SAS",
        "LOG",
        "LST",
        "INCLUDE",
        "CONFIG",
        "FORMAT",
        "REFERENCE"
      ]
    },
    "Encoding": {
      "type": "string",
      "enum": [
        "utf-8",
        "utf-8-sig",
        "ascii",
        "latin-1",
        "binary"
      ]
    },
    "ScopedFile": {
      "type": "object",
      "properties": {
        "file_key": {
          "$ref": "#/$defs/FileKey"
        },
        "root_id": {
          "$ref": "#/$defs/SafeId"
        },
        "path": {
          "$ref": "#/$defs/RelativePath"
        },
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "module_id": {
          "$ref": "#/$defs/SafeId"
        },
        "encoding": {
          "$ref": "#/$defs/Encoding"
        }
      },
      "required": [
        "file_key",
        "root_id",
        "path",
        "kind",
        "module_id",
        "encoding"
      ],
      "additionalProperties": false
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "dependency_id": {
          "$ref": "#/$defs/SafeId"
        },
        "from_file_key": {
          "$ref": "#/$defs/FileKey"
        },
        "to_file_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "INCLUDE",
            "CONFIG",
            "FORMAT",
            "MACRO",
            "OTHER"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "DECLARED",
            "UNRESOLVED"
          ]
        }
      },
      "required": [
        "dependency_id",
        "from_file_key",
        "to_file_key",
        "kind",
        "status"
      ],
      "additionalProperties": false
    },
    "LogAssociation": {
      "type": "object",
      "properties": {
        "association_id": {
          "$ref": "#/$defs/SafeId"
        },
        "log_file_key": {
          "$ref": "#/$defs/FileKey"
        },
        "source_file_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileKey"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "execution_id": {
          "$ref": "#/$defs/SafeId"
        },
        "run_id": {
          "$ref": "#/$defs/SafeId"
        },
        "status": {
          "const": "DECLARED"
        }
      },
      "required": [
        "association_id",
        "log_file_key",
        "source_file_keys",
        "execution_id",
        "run_id",
        "status"
      ],
      "additionalProperties": false
    },
    "LogicalRoot": {
      "type": "object",
      "properties": {
        "root_id": {
          "$ref": "#/$defs/SafeId"
        }
      },
      "required": [
        "root_id"
      ],
      "additionalProperties": false
    },
    "LogicalScope": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/SafeId"
        },
        "run_id": {
          "$ref": "#/$defs/SafeId"
        },
        "module_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SafeId"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "synthetic": {
          "const": true
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogicalRoot"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScopedFile"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "log_associations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogAssociation"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "workspace_id",
        "run_id",
        "module_ids",
        "synthetic",
        "roots",
        "files",
        "dependencies",
        "log_associations"
      ],
      "additionalProperties": false
    },
    "LegacyScopeIdentityInput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "workspace_id": {
          "$ref": "#/$defs/SafeId"
        },
        "run_id": {
          "$ref": "#/$defs/SafeId"
        },
        "module_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SafeId"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "synthetic": {
          "const": true
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogicalRoot"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScopedFile"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "log_associations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogAssociation"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "schema_version",
        "workspace_id",
        "run_id",
        "module_ids",
        "synthetic",
        "roots",
        "files",
        "dependencies",
        "log_associations"
      ],
      "additionalProperties": false
    },
    "Platform": {
      "enum": [
        "windows",
        "posix"
      ]
    },
    "Binding": {
      "type": "object",
      "properties": {
        "root_id": {
          "$ref": "#/$defs/SafeId"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "root_id",
        "platform",
        "path"
      ],
      "additionalProperties": false
    },
    "AuthorizationDeclaration": {
      "type": "object",
      "properties": {
        "declaration_id": {
          "$ref": "#/$defs/SafeId"
        },
        "declared_by": {
          "$ref": "#/$defs/SafeId"
        },
        "approval_reference": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+(?![\\s\\S])"
            }
          ]
        },
        "status": {
          "const": "DECLARED"
        },
        "human_approval": {
          "const": "NOT_VERIFIED"
        },
        "access": {
          "const": "READ_ONLY"
        }
      },
      "required": [
        "declaration_id",
        "declared_by",
        "approval_reference",
        "status",
        "human_approval",
        "access"
      ],
      "additionalProperties": false
    }
  }
}
